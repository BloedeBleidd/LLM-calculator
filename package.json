{
  "name": "llm-multi-gpu-optimizer",
  "version": "3.0.0",
  "private": true,
  "description": "Dependency-free static LLM layer-split estimator",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "dev": "node scripts/serve.cjs",
    "build": "node scripts/build.cjs",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8795",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "deploy:built": "node scripts/deploy.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.0",
    "wrangler": "4.151.0"
  }
}
